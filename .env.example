# Copy to .env (gitignored) and fill in values for your environment.
# Read by both docker-compose.yml (dev) and docker-compose.prod.yml.

# --- Local dev (docker-compose.yml) ---
# ALLOWED_ORIGINS=http://localhost:5173
# VITE_API_URL=http://localhost:8000

# --- Self-hosted VM (docker-compose.prod.yml) ---
# Backend CORS allow-list (comma-separated if more than one origin).
ALLOWED_ORIGINS=https://checklist.rtmdemos.name.ng
# Empty = same-origin relative API calls (the nginx reverse proxy handles
# routing /api and /health to the backend on this same domain).
VITE_API_URL=
# Absolute path so it lands in the backend-data named volume.
DATABASE_URL=sqlite:////app/data/todos.db
